{
  "name": "spynons-rotation",
  "version": "0.0.0",
  "private": true,
  "description": "A generic World of Warcraft rotation-assistant platform under the Spynon brand.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "bootstrap": "npm run toolchain:doctor && npm run project:status && npm run project:check",
    "project:status": "node tools/project/status.mjs",
    "project:check": "node tools/project/check.mjs",
    "project:test": "node --test tests/project/board.test.mjs tests/project/commands.test.mjs tests/project/sync.test.mjs",
    "project:sync": "node tools/project/sync.mjs",
    "toolchain:doctor": "node tools/toolchain/doctor.mjs",
    "simc:doctor": "node rotation-lab/simc/cli.mjs doctor",
    "simc:run": "node rotation-lab/simc/cli.mjs run",
    "simc:smoke": "node rotation-lab/simc/cli.mjs run --profile rotation-lab/fixtures/simc-cli-smoke.simc --name lab001-smoke --iterations 1 --threads 1 --max-time 1 --fixed-time",
    "simc:test": "node --test tests/rotation-lab/simc-runner.test.mjs",
    "dsl:check": "node rotation-lab/dsl/cli.mjs check",
    "dsl:test": "node --test tests/rotation-lab/dsl.test.mjs",
    "compiler:check": "node rotation-lab/compiler/cli.mjs verify",
    "compiler:test": "node --test tests/rotation-lab/compiler.test.mjs",
    "scenario:check": "node rotation-lab/scenarios/cli.mjs verify",
    "scenario:test": "node --test tests/rotation-lab/scenarios.test.mjs",
    "optimizer:check": "node rotation-lab/optimizer/cli.mjs verify",
    "optimizer:test": "node --test tests/rotation-lab/optimizer.test.mjs",
    "regression:check": "node rotation-lab/regression/cli.mjs verify",
    "regression:test": "node --test tests/rotation-lab/regression.test.mjs",
    "layout:check": "node tools/validation/check-layout.mjs",
    "core:test": "node tools/validation/run-lua-tests.mjs",
    "addon:lint": "node tools/validation/run-luacheck.mjs",
    "addon:typecheck": "node tools/validation/run-wowlua-ls.mjs",
    "test": "npm run project:check && npm run project:test && npm run simc:test && npm run dsl:test && npm run compiler:test && npm run compiler:check && npm run scenario:test && npm run scenario:check && npm run optimizer:test && npm run optimizer:check && npm run regression:test && npm run regression:check && npm run core:test && npm run layout:check && npm run addon:lint && npm run addon:typecheck"
  },
  "license": "UNLICENSED"
}
