{
  "schemaVersion": 1,
  "id": "neutral.compiler_fixture",
  "version": "1.0.0",
  "description": "Fixture neutra do compilador; não representa uma classe, spec ou baseline real.",
  "entrypoint": "default",
  "lists": [
    {
      "id": "default",
      "rules": [
        {
          "id": "neutral.default_strike_1",
          "priority": 10,
          "action": "neutral.strike",
          "capability": "ADDON_AVAILABLE",
          "when": {
            "kind": "all",
            "conditions": [
              {
                "kind": "truthy",
                "value": {
                  "kind": "state",
                  "path": ["cooldowns", "neutral.strike", "ready"],
                  "capability": "ADDON_AVAILABLE"
                }
              },
              {
                "kind": "compare",
                "operator": "gte",
                "left": {
                  "kind": "state",
                  "path": ["resources", "neutral_energy", "current"],
                  "capability": "ADDON_AVAILABLE"
                },
                "right": {
                  "kind": "literal",
                  "value": 50
                }
              }
            ]
          }
        },
        {
          "id": "neutral.default_cleave_1",
          "priority": 20,
          "action": "neutral.cleave",
          "capability": "CONDITIONALLY_SECRET",
          "onUnavailable": "skip_rule",
          "when": {
            "kind": "compare",
            "operator": "gte",
            "left": {
              "kind": "state",
              "path": ["target", "estimated_count"],
              "capability": "CONDITIONALLY_SECRET"
            },
            "right": {
              "kind": "literal",
              "value": 2
            }
          }
        },
        {
          "id": "neutral.default_execute_1",
          "priority": 30,
          "action": "neutral.execute",
          "capability": "SIM_ONLY",
          "when": {
            "kind": "compare",
            "operator": "lte",
            "left": {
              "kind": "state",
              "path": ["simulation", "target_time_to_die"],
              "capability": "SIM_ONLY"
            },
            "right": {
              "kind": "literal",
              "value": 15
            }
          }
        }
      ]
    },
    {
      "id": "maintenance",
      "rules": [
        {
          "id": "neutral.maintenance_maintenance_1",
          "priority": 10,
          "action": "neutral.maintenance",
          "capability": "ADDON_AVAILABLE",
          "when": {
            "kind": "constant",
            "value": true
          }
        }
      ]
    }
  ]
}
